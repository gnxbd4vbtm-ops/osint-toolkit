<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:OsintToolkit.WPF.ViewModels" x:Class="OsintToolkit.WPF.MainWindow" Title="OSINT Toolkit" Width="1280" Height="820" MinWidth="1000" MinHeight="650">
 <Window.DataTemplates>
  <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}"><StackPanel Margin="32" Spacing="16"><TextBlock Text="Intelligence overview" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your OSINT activity at a glance" Opacity=".7"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="16"><Border Background="#182641" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="TOTAL TARGETS" Opacity=".7"/><TextBlock Text="{Binding TargetCount}" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="#182641" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="TOTAL FINDINGS" Opacity=".7"/><TextBlock Text="{Binding FindingCount}" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Background="#30213D" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="HIGH / CRITICAL" Opacity=".7"/><TextBlock Text="{Binding HighRiskCount}" FontSize="32" FontWeight="Bold"/></StackPanel></Border></Grid><Border Background="#142039" CornerRadius="10" Padding="22"><StackPanel Spacing="10"><TextBlock Text="RECENT ACTIVITY" FontWeight="Bold"/><TextBlock Text="{Binding RecentActivity}" FontSize="16"/></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type vm:TargetsPageViewModel}"><Grid Margin="32" RowDefinitions="Auto,*" RowSpacing="16"><StackPanel Spacing="12"><TextBlock Text="Target management" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBox Width="320" PlaceholderText="Target value" Text="{Binding Shell.NewTargetValue}"/><ComboBox Width="150" ItemsSource="{Binding Shell.TargetTypes}" SelectedItem="{Binding Shell.NewTargetType}"/><Button Content="Add target" Command="{Binding Shell.AddTargetCommand}"/></StackPanel></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Shell.Targets}" SelectedItem="{Binding Shell.SelectedTarget}"><ListBox.ItemTemplate><DataTemplate><Border Padding="14" BorderBrush="#324766" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,130,180"><TextBlock Text="{Binding Value}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Type}"/><TextBlock Grid.Column="2" Text="{Binding LastScannedAt}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ScanPageViewModel}"><StackPanel Margin="32" Spacing="16"><TextBlock Text="Scan interface" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.SelectedTarget.Value}" Opacity=".7"/><Border Background="#142039" CornerRadius="10" Padding="28"><StackPanel Spacing="16"><TextBlock Text="Nmap profile (Domain/IP only)"/><ComboBox Width="220" ItemsSource="{Binding Shell.NmapProfiles}" SelectedItem="{Binding Shell.SelectedNmapProfile}"/><TextBlock Text="Discovery only identifies live hosts. Quick and Standard identify services; FullTcp scans all TCP ports. Scan only systems you are authorized to assess." TextWrapping="Wrap" Opacity=".7"/><TextBlock Text="{Binding Shell.CurrentModule}" FontSize="18" Margin="0,8,0,0"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Shell.ScanProgress}" Height="16"/><TextBlock Text="{Binding Shell.ScanProgress, StringFormat={}{0:F0}% complete}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Start scan" Command="{Binding Shell.StartScanCommand}"/><Button Content="Cancel scan" Command="{Binding Shell.CancelScanCommand}"/></StackPanel></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ResultsPageViewModel}"><Grid Margin="32" RowDefinitions="Auto,*" RowSpacing="16"><StackPanel Spacing="12"><TextBlock Text="Findings" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><ComboBox Width="310" ItemsSource="{Binding Shell.Sessions}" SelectedItem="{Binding Shell.SelectedSession}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Notes}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Width="270" PlaceholderText="Search findings" Text="{Binding Shell.FindingSearch}"/></StackPanel></StackPanel><Grid Grid.Row="1" ColumnDefinitions="*,1.1*" ColumnSpacing="16"><ListBox ItemsSource="{Binding Shell.FilteredFindings}" SelectedItem="{Binding Shell.SelectedFinding}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10" Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Severity}" Opacity=".7"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity=".75"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Background="#142039" CornerRadius="10" Padding="18"><StackPanel Spacing="9"><TextBlock Text="{Binding Shell.SelectedFinding.Title}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.SelectedFinding.Severity}"/><TextBlock Text="{Binding Shell.SelectedFinding.Summary}" TextWrapping="Wrap"/><TextBlock Text="Evidence / source data" FontWeight="Bold" Margin="0,14,0,0"/><TextBox Text="{Binding Shell.FindingEvidence}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="300" FontFamily="Monospace"/></StackPanel></Border></Grid></Grid></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ReportsPageViewModel}"><StackPanel Margin="32" Spacing="16"><TextBlock Text="Reports" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Select a previous scan and export a readable report or JSON data." Opacity=".7"/><ComboBox Width="430" ItemsSource="{Binding Shell.Sessions}" SelectedItem="{Binding Shell.SelectedSession}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Notes}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Export JSON" Command="{Binding Shell.ExportCommand}" CommandParameter="json"/><Button Content="Export Markdown" Command="{Binding Shell.ExportCommand}" CommandParameter="markdown"/><Button Content="Export HTML" Command="{Binding Shell.ExportCommand}" CommandParameter="html"/></StackPanel></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><ScrollViewer><StackPanel Margin="32" Width="520" Spacing="8"><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Configuration is shared with the CLI." Opacity=".7" Margin="0,0,0,14"/><TextBlock Text="Database location"/><TextBox Text="{Binding Shell.DatabasePath}"/><TextBlock Text="Logging level" Margin="0,8,0,0"/><TextBox Text="{Binding Shell.LogLevel}"/><TextBlock Text="Default export format" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Shell.ExportFormats}" SelectedItem="{Binding Shell.DefaultExportFormat}"/><TextBlock Text="Theme preference" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Shell.Themes}" SelectedItem="{Binding Shell.Theme}"/><TextBlock Text="API keys (one Key=Value pair per line)" Margin="0,8,0,0"/><TextBox Text="{Binding Shell.ApiKeysText}" AcceptsReturn="True" Height="100"/><Button Content="Save settings" HorizontalAlignment="Left" Command="{Binding Shell.SaveSettingsCommand}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></DataTemplate>
 </Window.DataTemplates>
 <Grid ColumnDefinitions="220,*"><Border Background="#0E1930" Padding="18"><StackPanel Spacing="5"><TextBlock Text="OSINT" FontSize="25" FontWeight="Bold"/><TextBlock Text="TOOLKIT" FontSize="11" Opacity=".7" Margin="2,0,0,25"/><Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Content="Targets" Command="{Binding NavigateCommand}" CommandParameter="Targets"/><Button Content="New scan" Command="{Binding NavigateCommand}" CommandParameter="Scan"/><Button Content="Results" Command="{Binding NavigateCommand}" CommandParameter="Results"/><Button Content="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports"/><Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Content="Refresh data" Command="{Binding RefreshCommand}" Margin="0,25,0,0"/></StackPanel></Border><Grid Grid.Column="1" RowDefinitions="*,34"><ContentControl Content="{Binding CurrentPage}"/><Border Grid.Row="1" Background="#101A2C" Padding="14,7"><TextBlock Text="{Binding StatusMessage}" Opacity=".75"/></Border></Grid></Grid>
</Window>
