<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OsintToolkit.Gui.MainWindow"
        Title="OsintToolkit GUI"
        Width="800" Height="600">
  <StackPanel Margin="12">
    <TextBlock Text="OSINT Toolkit" FontSize="18" />

    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <TextBox Name="TargetText" Width="360" Watermark="Enter target (domain, IP, username)" />
      <Button Name="ScanButton" Content="Run Scan" Width="120" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock Text="Recent Sessions" Margin="0,12,0,0" />
    <ListBox Name="SessionsList" Height="160" />

    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Button Name="RefreshSessionsButton" Content="Refresh" Width="100" />
      <Button Name="ExportButton" Content="Export Selected" Width="140" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock Text="Output" Margin="0,12,0,0" />
    <ListBox Name="OutputList" Margin="0,8,0,0" Height="200" />
  </StackPanel>
</Window>
